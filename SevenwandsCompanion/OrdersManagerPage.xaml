<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SevenwandsCompanion.OrdersManagerPage"
             Title="Gestion des Commandes"
             BackgroundColor="{DynamicResource BackgroundDark}"
             Shell.NavBarIsVisible="False">

    <Grid Padding="20" RowDefinitions="Auto, Auto, Auto, *" RowSpacing="15">

        <!-- En-tête -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="5">
                <Label Text="📋 GESTION DES COMMANDES"
                       Style="{StaticResource TitleStyle}"
                       HorizontalOptions="Start"/>
                <Label Text="Suivez les commandes des autres joueurs"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}"/>
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="← Retour"
                    FontSize="14"
                    BackgroundColor="{StaticResource ButtonBackground}"
                    TextColor="{StaticResource TextPrimary}"
                    CornerRadius="8"
                    Padding="20,10"
                    Clicked="OnBackClicked"
                    VerticalOptions="Center"/>
        </Grid>

        <!-- Boutons d'action -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="➕ Nouvelle commande"
                    FontSize="14"
                    BackgroundColor="{DynamicResource ButtonBackground}"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="15,10"
                    Clicked="OnNewOrderClicked"/>
            <Button Grid.Column="1"
                    Text="🗑️ Supprimer"
                    FontSize="14"
                    BackgroundColor="{DynamicResource AccentRed}"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="15,10"
                    Clicked="OnDeleteOrderClicked"
                    IsEnabled="{Binding SelectedOrder, Converter={StaticResource IsNotNullConverter}}"/>
        </Grid>

        <!-- Tri -->
        <Picker Grid.Row="2"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSort}"
                Style="{StaticResource PickerStyle}"
                Title="Trier par"/>

        <!-- Liste des commandes -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <CollectionView ItemsSource="{Binding Orders}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedOrder}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ButtonBackground}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Commande terminée : carte assombrie/grisée pour la distinguer
                                 nettement d'une commande en cours, indépendamment de l'état de
                                 sélection ci-dessus. -->
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                            </Grid.Triggers>

                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="6">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding CustomerName}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                                     Spacing="0"
                                                     HorizontalOptions="End">
                                    <Label Text="{Binding NegotiatedPriceDisplay}"
                                           TextColor="{StaticResource AccentGold}"
                                           FontAttributes="Bold"
                                           FontSize="22"
                                           HorizontalOptions="End"/>
                                    <Label Text="{Binding StatusDisplay}"
                                           TextColor="{Binding StatusColor}"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           HorizontalOptions="End"/>
                                </VerticalStackLayout>

                                <!-- Bandeau d'action : vert et cliquable ("Marquer comme
                                     terminée") tant que la commande est en cours ; une fois
                                     terminée, un bandeau grisé non cliquable prend sa place au
                                     même endroit pour que le statut saute aux yeux et ne se
                                     confonde jamais avec une commande en cours. Un vrai Button
                                     comme enfant d'un item template de CollectionView ne se rend
                                     pas du tout sur WinUI (bug constaté ailleurs dans l'app), donc
                                     Label + tap sur un bandeau pleine largeur. -->
                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      IsVisible="{Binding IsPending}"
                                      BackgroundColor="{Binding ActionBarColor}"
                                      HorizontalOptions="Fill"
                                      Padding="14,10">
                                    <Label Text="{Binding ActionBarText}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           HorizontalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCompleteOrderTapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      IsVisible="{Binding IsCompleted}"
                                      BackgroundColor="#3A3A3A"
                                      HorizontalOptions="Fill"
                                      Padding="14,10">
                                    <Label Text="✔️ COMMANDE TERMINÉE"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           HorizontalOptions="Center"/>
                                </Grid>

                                <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                     Spacing="2"
                                                     BindableLayout.ItemsSource="{Binding ProductStocks}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding Display}"
                                                   TextColor="{Binding StatusColor}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"/>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding DeadlineDisplay}"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="11"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
