<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SevenwandsCompanion.ResourceEditorPage"
             Title="Édition Ressource"
             BackgroundColor="{DynamicResource BackgroundDark}"
             Shell.NavBarIsVisible="False">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" MaximumWidthRequest="700" HorizontalOptions="Center">

            <Label Text="{Binding PageTitle}"
                   Style="{StaticResource TitleStyle}"
                   HorizontalOptions="Start"/>

            <Border Style="{StaticResource CardStyle}" Padding="20">
                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nom de la ressource *"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12"/>
                        <Entry Text="{Binding ResourceName}"
                               Style="{StaticResource EntryStyle}"
                               Placeholder="Ex: Minerai de fer"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Description"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12"/>
                        <Editor Text="{Binding Description}"
                                TextColor="{StaticResource TextPrimary}"
                                BackgroundColor="{StaticResource BackgroundCard}"
                                Placeholder="Décrivez la ressource..."
                                HeightRequest="70"
                                AutoSize="TextChanges"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Type *"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12"/>
                        <Picker ItemsSource="{Binding AvailableTypes}"
                                SelectedItem="{Binding SelectedType}"
                                Style="{StaticResource PickerStyle}"/>
                        <Label Text="ingredient: utilisée dans une recette de potion | resource: matière première (Forge, Auberge...) | ingredientAndResource: les deux à la fois | resourceAndProduct: ressource vendable directement comme produit (sans recette, ex: Alcool de fée) | ingredientAndResourceAndProduct: les trois à la fois"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="10"
                               Margin="0,5,0,0"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Prix (Gallyons) - Optionnel"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12"/>
                        <Entry Text="{Binding PriceText}"
                               Keyboard="Numeric"
                               Style="{StaticResource EntryStyle}"
                               Placeholder="Laissez vide si non achetable"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Catégories commerciales"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12"/>
                        <Label Text="Une ressource peut appartenir à plusieurs catégories (ex: Forge et Auberge)."
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="10"/>
                        <FlexLayout BindableLayout.ItemsSource="{Binding CategoryToggles}"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="Start"
                                    Margin="0,5,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <HorizontalStackLayout Spacing="4" Margin="0,0,15,8">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Color="{StaticResource AccentGold}"/>
                                        <Label Text="{Binding Category.Name}"
                                               TextColor="{StaticResource TextPrimary}"
                                               FontSize="13"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Recette (uniquement pour resourceAndProduct / ingredientAndResourceAndProduct) -->
            <Border Style="{StaticResource CardStyle}" Padding="20" IsVisible="{Binding IsProductType}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="📜 RECETTE (optionnelle)" Style="{StaticResource SectionTitleStyle}"/>
                    <Label Text="Cette ressource apparaît côté Produits sous ses propres catégories Ressources (ci-dessus) - pas de catégorisation séparée à refaire."
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="10"/>
                    <Label Text="Laissez vide pour une ressource brute (récoltée telle quelle). Sinon, indiquez les ressources et/ou produits nécessaires pour la 'fabriquer' - purement informatif, comme pour un produit."
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="10"/>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecipeComponents}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}"
                                        BackgroundColor="{StaticResource BackgroundDark}"
                                        Margin="0,5"
                                        Padding="12">
                                    <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="10">
                                        <Picker Grid.Column="0"
                                                ItemsSource="{Binding AvailableComponents}"
                                                ItemDisplayBinding="{Binding DisplayName}"
                                                SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
                                                Style="{StaticResource PickerStyle}"
                                                VerticalOptions="Center"/>

                                        <Entry Grid.Column="1"
                                               Text="{Binding Quantity}"
                                               Keyboard="Numeric"
                                               WidthRequest="80"
                                               Style="{StaticResource EntryStyle}"
                                               Placeholder="Qté"
                                               VerticalOptions="Center"/>

                                        <Label Grid.Column="2"
                                               Text="x"
                                               TextColor="{StaticResource TextSecondary}"
                                               FontSize="14"
                                               VerticalOptions="Center"/>

                                        <Button Grid.Column="3"
                                                Text="🗑️"
                                                FontSize="16"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                BackgroundColor="{DynamicResource AccentRed}"
                                                TextColor="White"
                                                CornerRadius="6"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnRemoveRecipeComponentClicked"
                                                VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Aucun composant ajouté (ressource brute)."
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="12"
                           HorizontalOptions="Center"
                           Margin="0,10"
                           IsVisible="{Binding HasNoRecipeComponents}"/>

                    <Button Text="+ Ajouter un composant (ingrédient ou produit)"
                            FontSize="12"
                            BackgroundColor="{DynamicResource ButtonBackground}"
                            TextColor="White"
                            CornerRadius="6"
                            Padding="15,10"
                            Clicked="OnAddRecipeComponentClicked"/>
                </VerticalStackLayout>
            </Border>

            <!-- Boutons d'action -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="15" Margin="0,10,0,20">
                <Button Grid.Column="0"
                        Text="🗑️ Supprimer"
                        BackgroundColor="{DynamicResource AccentRed}"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="8"
                        Clicked="OnDeleteClicked"
                        IsVisible="{Binding IsEditMode}"/>

                <Button Grid.Column="1"
                        Text="❌ Annuler"
                        BackgroundColor="{StaticResource ButtonBackground}"
                        TextColor="{StaticResource TextPrimary}"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="8"
                        Clicked="OnCancelClicked"/>

                <Button Grid.Column="2"
                        Text="💾 Enregistrer"
                        BackgroundColor="{DynamicResource ButtonBackground}"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="8"
                        Clicked="OnSaveClicked"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
